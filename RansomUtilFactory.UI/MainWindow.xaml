<Window x:Class="RansomUtilFactory.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RansomUtilFactory 개발 도구" Height="760" Width="1120"
        MinHeight="620" MinWidth="900"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top" Background="#FFF3F6FA" BorderBrush="#FFD7DEE8"
                BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="ConnectionIndicator" Width="12" Height="12"
                             Fill="#FFB3261E" Margin="0,0,8,0" />
                    <TextBlock x:Name="ConnectionText" Text="드라이버 연결 안 됨"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="연결" Click="Connect_Click" />
                    <Button Content="연결 해제" Click="Disconnect_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl>
            <TabItem Header="파일 제어">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="340" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <GroupBox Header="감시 폴더" Padding="8">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                            HorizontalAlignment="Right" Margin="0,8,0,0">
                                    <Button Content="폴더 추가" Click="AddMonitorFolder_Click" />
                                    <Button Content="선택 제거" Click="RemoveMonitorFolder_Click" />
                                </StackPanel>
                                <ListBox x:Name="MonitorFolderList" ItemsSource="{Binding MonitorFolders}" />
                            </DockPanel>
                        </GroupBox>

                        <GroupBox Grid.Column="2" Header="보호 폴더" Padding="8">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Bottom">
                                    <TextBlock Margin="4,6,4,0"
                                               Foreground="#FF8A3B12" TextWrapping="Wrap"
                                               Text="허용 프로세스마다 읽기·쓰기, 코드 서명 확인 여부와 비교 방식을 설정합니다. 권한을 모두 끄면 정책을 적용할 수 없습니다." />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                Margin="0,8,0,0">
                                        <Button Content="폴더 추가" Click="AddProtectFolder_Click" />
                                        <Button Content="선택 제거" Click="RemoveProtectFolder_Click" />
                                    </StackPanel>
                                    <TextBlock Text="선택 폴더의 허용 프로그램" Margin="4,8,4,2" />
                                    <ListBox x:Name="AllowedProcessList" Height="86">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" ToolTip="{Binding Path}" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <CheckBox Content="읽기"
                                                                  IsChecked="{Binding AllowRead, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  Margin="8,0,0,0" VerticalAlignment="Center" />
                                                        <CheckBox Content="쓰기"
                                                                  IsChecked="{Binding AllowWrite, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  Margin="8,0,0,0" VerticalAlignment="Center" />
                                                        <CheckBox Content="코드 서명"
                                                                  IsChecked="{Binding RequireCodeSignature, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  Margin="8,0,0,0" VerticalAlignment="Center" />
                                                        <ComboBox SelectedIndex="{Binding MatchMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  ToolTip="프로세스 전체 경로 또는 실행 파일 이름으로 비교합니다."
                                                                  Width="108" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <ComboBoxItem Content="전체 경로" />
                                                            <ComboBoxItem Content="프로세스 이름" />
                                                        </ComboBox>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                Margin="0,6,0,0">
                                        <Button Content="프로그램 추가" Click="AddAllowedProcess_Click" />
                                        <Button Content="선택 제거" Click="RemoveAllowedProcess_Click" />
                                    </StackPanel>
                                </StackPanel>
                                <ListBox x:Name="ProtectFolderList" ItemsSource="{Binding ProtectFolders}"
                                         DisplayMemberPath="Path"
                                         SelectionChanged="ProtectFolderList_SelectionChanged" />
                            </DockPanel>
                        </GroupBox>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,10,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                <Button Content="파일 드라이버 설치" Click="InstallFileDriver_Click" />
                                <Button Content="파일 드라이버 제거" Click="UninstallFileDriver_Click" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" x:Name="FileDriverStatusText"
                                       Text="설치 상태를 확인하지 않았습니다."
                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                       TextWrapping="Wrap" />
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PolicyStatusText" Text="정책이 적용되지 않았습니다."
                                       VerticalAlignment="Center" Margin="0,0,12,0"
                                       TextWrapping="Wrap" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="ApplyPolicyButton" Content="정책 적용" Click="ApplyPolicy_Click" />
                                <Button x:Name="ClearPolicyButton" Content="정책 초기화" Click="ClearPolicy_Click" />
                                <Button Content="로그 지우기" Click="ClearLog_Click" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <GroupBox Grid.Row="2" Header="파일 이벤트 로그" Padding="8">
                        <DataGrid ItemsSource="{Binding EventLogs}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                                  EnableRowVirtualization="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="시각" Binding="{Binding Time}" Width="145" />
                                <DataGridTextColumn Header="구분" Binding="{Binding Action}" Width="70" />
                                <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="75" />
                                <DataGridTextColumn Header="프로세스" Binding="{Binding Image}" Width="240" />
                                <DataGridTextColumn Header="파일 경로" Binding="{Binding Path}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="프로세스 제어">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="220" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <GroupBox Header="실행 차단 정책" Padding="8">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                        HorizontalAlignment="Right" Margin="0,8,0,0">
                                <Button Content="전체 경로 추가" Click="AddProcessPathRule_Click" />
                                <Button Content="파일 이름 추가" Click="AddProcessNameRule_Click" />
                                <Button Content="선택 제거" Click="RemoveProcessRule_Click" />
                                <Button x:Name="ApplyProcessPolicyButton" Content="정책 적용"
                                        Click="ApplyProcessPolicy_Click" />
                                <Button x:Name="ClearProcessPolicyButton" Content="정책 초기화"
                                        Click="ClearProcessPolicy_Click" />
                            </StackPanel>
                            <DataGrid x:Name="ProcessRuleGrid" ItemsSource="{Binding ProcessRules}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" SelectionMode="Extended">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="규칙 ID" Binding="{Binding RuleId}" Width="80" />
                                    <DataGridTextColumn Header="비교 방식" Binding="{Binding MatchModeText}" Width="110" />
                                    <DataGridTextColumn Header="실행 파일" Binding="{Binding Image}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </GroupBox>

                    <Grid Grid.Row="1" Margin="0,10,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="드라이버 설치" Click="InstallProcessDriver_Click" />
                                <Button Content="로드 및 연결" Click="ConnectProcessDriver_Click" />
                                <Button Content="연결 해제" Click="DisconnectProcessDriver_Click" />
                                <Button Content="드라이버 제거" Click="UninstallProcessDriver_Click" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" x:Name="ProcessDriverStatusText"
                                       Text="설치 상태를 확인하지 않았습니다."
                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                       TextWrapping="Wrap" />
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ProcessPolicyStatusText"
                                       Text="프로세스 정책이 적용되지 않았습니다."
                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                            <Button Grid.Column="1" Content="로그 지우기"
                                    Click="ClearProcessLog_Click" />
                        </Grid>
                    </Grid>

                    <GroupBox Grid.Row="2" Header="프로세스 실행·접근 이벤트 로그" Padding="8">
                        <DataGrid ItemsSource="{Binding ProcessEventLogs}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False"
                                  EnableRowVirtualization="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="시각" Binding="{Binding Time}" Width="145" />
                                <DataGridTextColumn Header="구분" Binding="{Binding Type}" Width="65" />
                                <DataGridTextColumn Header="결과" Binding="{Binding Action}" Width="65" />
                                <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="70" />
                                <DataGridTextColumn Header="요청 PID" Binding="{Binding RequesterProcessId}" Width="80" />
                                <DataGridTextColumn Header="대상 PID" Binding="{Binding TargetProcessId}" Width="80" />
                                <DataGridTextColumn Header="권한" Binding="{Binding DesiredAccess}" Width="95" />
                                <DataGridTextColumn Header="실행 파일" Binding="{Binding Image}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
