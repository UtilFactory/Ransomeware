<Window x:Class="RansomUtilFactory.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RansomUtilFactory 개발 도구" Height="760" Width="1120"
        MinHeight="620" MinWidth="900"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top" Background="#FFF3F6FA" BorderBrush="#FFD7DEE8"
                BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="드라이버 연결 상태" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <WrapPanel Grid.Row="1">
                        <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                            <Ellipse x:Name="FileDriverConnectionIndicator" Width="12" Height="12"
                                     Fill="#FFB3261E" Margin="0,0,8,0" />
                            <TextBlock x:Name="FileDriverConnectionText" Text="파일 필터: 연결 안 됨"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                            <Ellipse x:Name="ProcessDriverConnectionIndicator" Width="12" Height="12"
                                     Fill="#FFB3261E" Margin="0,0,8,0" />
                            <TextBlock x:Name="ProcessDriverConnectionText" Text="프로세스 제어 필터: 연결 안 됨"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Ellipse x:Name="BootDriverConnectionIndicator" Width="12" Height="12"
                                     Fill="#FFB3261E" Margin="0,0,8,0" />
                            <TextBlock x:Name="BootDriverConnectionText" Text="부트 필터: 확인 전"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </WrapPanel>
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="파일 필터 연결" Click="Connect_Click" />
                        <Button Content="파일 필터 연결 해제" Click="Disconnect_Click" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="프로세스 필터 로드·연결" Click="ConnectProcessDriver_Click" />
                        <Button Content="프로세스 필터 연결 해제" Click="DisconnectProcessDriver_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl>
            <TabItem Header="파일 제어">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="340" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <GroupBox Header="감시 폴더" Padding="8">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                            HorizontalAlignment="Right" Margin="0,8,0,0">
                                    <Button Content="폴더 추가" Click="AddMonitorFolder_Click" />
                                    <Button Content="선택 제거" Click="RemoveMonitorFolder_Click" />
                                </StackPanel>
                                <ListBox x:Name="MonitorFolderList" ItemsSource="{Binding MonitorFolders}" />
                            </DockPanel>
                        </GroupBox>

                        <GroupBox Grid.Column="2" Header="보호 폴더" Padding="8">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Bottom">
                                    <TextBlock Margin="4,6,4,0"
                                               Foreground="#FF8A3B12" TextWrapping="Wrap"
                                               Text="허용 프로세스마다 읽기·쓰기, 코드 서명 확인 여부와 비교 방식을 설정합니다. 권한을 모두 끄면 정책을 적용할 수 없습니다." />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                Margin="0,8,0,0">
                                        <Button Content="폴더 추가" Click="AddProtectFolder_Click" />
                                        <Button Content="선택 제거" Click="RemoveProtectFolder_Click" />
                                    </StackPanel>
                                    <TextBlock Text="선택 폴더의 허용 프로그램" Margin="4,8,4,2" />
                                    <ListBox x:Name="AllowedProcessList" Height="86">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" ToolTip="{Binding Path}" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <CheckBox Content="읽기"
                                                                  IsChecked="{Binding AllowRead, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  Margin="8,0,0,0" VerticalAlignment="Center" />
                                                        <CheckBox Content="쓰기"
                                                                  IsChecked="{Binding AllowWrite, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  Margin="8,0,0,0" VerticalAlignment="Center" />
                                                        <CheckBox Content="코드 서명"
                                                                  IsChecked="{Binding RequireCodeSignature, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  Margin="8,0,0,0" VerticalAlignment="Center" />
                                                        <ComboBox SelectedIndex="{Binding MatchMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  ToolTip="프로세스 전체 경로 또는 실행 파일 이름으로 비교합니다."
                                                                  Width="108" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <ComboBoxItem Content="전체 경로" />
                                                            <ComboBoxItem Content="프로세스 이름" />
                                                        </ComboBox>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                Margin="0,6,0,0">
                                        <Button Content="프로그램 추가" Click="AddAllowedProcess_Click" />
                                        <Button Content="선택 제거" Click="RemoveAllowedProcess_Click" />
                                    </StackPanel>
                                </StackPanel>
                                <ListBox x:Name="ProtectFolderList" ItemsSource="{Binding ProtectFolders}"
                                         DisplayMemberPath="Path"
                                         SelectionChanged="ProtectFolderList_SelectionChanged" />
                            </DockPanel>
                        </GroupBox>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,10,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                <Button Content="파일 필터 설치" Click="InstallFileDriver_Click" />
                                <Button Content="파일 필터 제거" Click="UninstallFileDriver_Click" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" x:Name="FileDriverStatusText"
                                       Text="설치 상태를 확인하지 않았습니다."
                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                       TextWrapping="Wrap" />
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PolicyStatusText" Text="정책이 적용되지 않았습니다."
                                       VerticalAlignment="Center" Margin="0,0,12,0"
                                       TextWrapping="Wrap" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="ApplyPolicyButton" Content="정책 적용" Click="ApplyPolicy_Click" />
                                <Button x:Name="ClearPolicyButton" Content="정책 초기화" Click="ClearPolicy_Click" />
                                <Button Content="로그 지우기" Click="ClearLog_Click" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <GroupBox Grid.Row="2" Header="파일 이벤트 로그" Padding="8">
                        <DataGrid ItemsSource="{Binding EventLogs}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                                  EnableRowVirtualization="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="시각" Binding="{Binding Time}" Width="145" />
                                <DataGridTextColumn Header="구분" Binding="{Binding Action}" Width="70" />
                                <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="75" />
                                <DataGridTextColumn Header="프로세스" Binding="{Binding Image}" Width="240" />
                                <DataGridTextColumn Header="파일 경로" Binding="{Binding Path}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="프로세스 제어">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="220" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <GroupBox Header="프로세스 실행 허용 정책" Padding="8">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                        HorizontalAlignment="Right" Margin="0,8,0,0">
                                <Button Content="전체 경로 추가" Click="AddProcessPathRule_Click" />
                                <Button Content="파일 이름 추가" Click="AddProcessNameRule_Click" />
                                <Button Content="선택 제거" Click="RemoveProcessRule_Click" />
                                <Button x:Name="ApplyProcessPolicyButton" Content="정책 적용"
                                        Click="ApplyProcessPolicy_Click" />
                                <Button x:Name="ClearProcessPolicyButton" Content="정책 초기화"
                                        Click="ClearProcessPolicy_Click" />
                            </StackPanel>
                            <DataGrid x:Name="ProcessRuleGrid" ItemsSource="{Binding ProcessRules}"
                                      AutoGenerateColumns="False" IsReadOnly="False"
                                      CanUserAddRows="False" SelectionMode="Extended">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="규칙 ID" Binding="{Binding RuleId}" Width="80"
                                                        IsReadOnly="True" />
                                    <DataGridTextColumn Header="비교 방식" Binding="{Binding MatchModeText}" Width="110"
                                                        IsReadOnly="True" />
                                    <DataGridTextColumn Header="실행 파일" Binding="{Binding Image}" Width="*"
                                                        IsReadOnly="True" />
                                    <DataGridCheckBoxColumn Header="코드 서명 필요" Binding="{Binding IsSign, Mode=TwoWay}"
                                                            Width="110" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </GroupBox>

                    <Grid Grid.Row="1" Margin="0,10,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="프로세스 제어 필터 설치" Click="InstallProcessDriver_Click" />
                                <Button Content="프로세스 필터 로드·연결" Click="ConnectProcessDriver_Click" />
                                <Button Content="프로세스 필터 연결 해제" Click="DisconnectProcessDriver_Click" />
                                <Button Content="프로세스 제어 필터 제거" Click="UninstallProcessDriver_Click" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" x:Name="ProcessDriverStatusText"
                                       Text="설치 상태를 확인하지 않았습니다."
                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                       TextWrapping="Wrap" />
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ProcessPolicyStatusText"
                                       Text="프로세스 정책이 적용되지 않았습니다."
                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                            <Button Grid.Column="1" Content="로그 지우기"
                                    Click="ClearProcessLog_Click" />
                        </Grid>
                    </Grid>

                    <GroupBox Grid.Row="2" Header="정책에 등록된 프로세스 실행 로그 (차단 / 통과)" Padding="8">
                        <DataGrid ItemsSource="{Binding ProcessEventLogs}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False"
                                  EnableRowVirtualization="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="시각" Binding="{Binding Time}" Width="175" />
                                <DataGridTextColumn Header="프로세스명" Binding="{Binding ProcessName}" Width="160" />
                                <DataGridTextColumn Header="실행 결과" Binding="{Binding Action}" Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Action}" Value="차단">
                                                    <Setter Property="Foreground" Value="#B91C1C" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Action}" Value="통과">
                                                    <Setter Property="Foreground" Value="#15803D" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="70" />
                                <DataGridTextColumn Header="실행 파일 경로" Binding="{Binding Image}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </TabItem>
            <TabItem Header="부트 영역 방어">
                <ScrollViewer x:Name="BootTabScrollViewer" Margin="10" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <Grid x:Name="BootTabContent" Height="{Binding ViewportHeight, ElementName=BootTabScrollViewer}">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="MinHeight" Value="440" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExpanded, ElementName=BootSetupExpander}" Value="True">
                                    <Setter Property="MinHeight" Value="580" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="110" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="전용 데이터 VHDX의 MBR/GPT · FAT32/NTFS 부트 영역을 보호합니다. OS/부팅 디스크는 현재 지원하지 않습니다."
                               Foreground="#FF8A3B12" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <Expander x:Name="BootSetupExpander" Grid.Row="1" Header="드라이버 설치 · 시험 디스크 필터 등록 (펼치기)"
                              IsExpanded="False" Padding="6">
                        <StackPanel>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button x:Name="InstallBootDriverButton" Content="드라이버 패키지 설치" Click="InstallBootDriver_Click" />
                                    <Button x:Name="RefreshBootButton" Content="새로 고침" Click="RefreshBoot_Click" />
                                </StackPanel>
                                <TextBlock Text="시험 디스크 선택" VerticalAlignment="Center" Margin="2,0,8,0" />
                            </DockPanel>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button x:Name="AttachBootFilterButton" Content="필터 등록" Click="AttachBootFilter_Click" IsEnabled="False" />
                                    <Button x:Name="DetachBootFilterButton" Content="필터 등록 해제" Click="DetachBootFilter_Click" IsEnabled="False" />
                                </StackPanel>
                                <ComboBox x:Name="BootCandidateList" DisplayMemberPath="DisplayName" MinWidth="230" Margin="2,4,6,4"
                                          SelectionChanged="BootCandidateList_SelectionChanged" />
                            </DockPanel>
                            <TextBlock x:Name="BootInstallStatusText" Text="패키지 설치 → 시험 디스크에 필터 등록 → VHDX 다시 연결 또는 VM 재부팅 → 새로 고침"
                                       TextWrapping="Wrap" Margin="2,4,2,0" />
                        </StackPanel>
                    </Expander>
                    <StackPanel Grid.Row="2" Margin="0,8,0,6">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="StartBootProtectionButton" Content="부트 영역 방어 시작" Click="StartBootProtection_Click" IsEnabled="False" />
                                <Button x:Name="StopBootProtectionButton" Content="부트 영역 방어 정지" Click="StopBootProtection_Click" IsEnabled="False" />
                            </StackPanel>
                            <ComboBox x:Name="BootDeviceList" DisplayMemberPath="DisplayName" Margin="2,4,6,4"
                                      SelectionChanged="BootDeviceList_SelectionChanged"
                                      ToolTip="커널이 실제 부착되었다고 응답한 디스크를 선택합니다." />
                        </DockPanel>
                        <TextBlock x:Name="BootProtectionStatusText" Text="부트 필터의 현재 보호 상태를 확인하지 않았습니다."
                                   FontWeight="SemiBold" TextWrapping="Wrap" Margin="2,4,2,0" />
                        <TextBlock x:Name="BootCommandStatusText" Text="" TextWrapping="Wrap" Margin="2,2,2,0" />
                        <TextBlock Text="시작·정지는 선택한 디스크에 적용됩니다. UI를 닫아도 활성 보호는 유지됩니다."
                                   Margin="2,4,2,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <GroupBox Grid.Row="3" Header="선택 디스크의 보호 범위" Padding="5" Margin="0,0,0,8">
                        <DataGrid x:Name="BootRangeGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" HeadersVisibility="Column" EnableRowVirtualization="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="영역" Binding="{Binding Kind}" Width="140" />
                                <DataGridTextColumn Header="시작 위치 (바이트)" Binding="{Binding Offset}" Width="180" />
                                <DataGridTextColumn Header="길이 (바이트)" Binding="{Binding Length}" Width="180" />
                                <DataGridTextColumn Header="끝 위치 (미포함)" Binding="{Binding End}" Width="180" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                    <GroupBox Grid.Row="4" Header="부트 영역 차단 · 상태 이벤트" Padding="5">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                <Button DockPanel.Dock="Right" Content="로그 지우기" Click="ClearBootLog_Click" />
                                <TextBlock x:Name="BootEventStatusText" Text="이벤트 수신 대기" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                            <DataGrid x:Name="BootEventGrid" ItemsSource="{Binding BootEventLogs}" AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" HeadersVisibility="Column" EnableRowVirtualization="True" EnableColumnVirtualization="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="시각" Binding="{Binding Time}" Width="160" />
                                    <DataGridTextColumn Header="구분" Binding="{Binding Action}" Width="90" />
                                    <DataGridTextColumn Header="디스크" Binding="{Binding Device}" Width="90" />
                                    <DataGridTextColumn Header="영역" Binding="{Binding Kind}" Width="90" />
                                    <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="65" />
                                    <DataGridTextColumn Header="요청 프로세스 경로" Binding="{Binding Path}" Width="320" />
                                    <DataGridTextColumn Header="경로 확인 방법" Binding="{Binding PathSource}" Width="200" />
                                    <DataGridTextColumn Header="위치 (바이트)" Binding="{Binding Offset}" Width="130" />
                                    <DataGridTextColumn Header="길이 (바이트)" Binding="{Binding Length}" Width="110" />
                                    <DataGridTextColumn Header="NTSTATUS" Binding="{Binding Status}" Width="110" />
                                    <DataGridTextColumn Header="제어 코드" Binding="{Binding Ioctl}" Width="100" />
                                    <DataGridTextColumn Header="정책 세대" Binding="{Binding Generation}" Width="85" />
                                    <DataGridTextColumn Header="이벤트 번호" Binding="{Binding Sequence}" Width="90" />
                                    <DataGridTextColumn Header="프로세스 생성 시각" Binding="{Binding ProcessCreated}" Width="155" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </GroupBox>
                </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
