<Window x:Class="RansomUtilFactory.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RansomUtilFactory 개발 도구" Height="760" Width="1120"
        MinHeight="620" MinWidth="900"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top" Background="#FFF3F6FA" BorderBrush="#FFD7DEE8"
                BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="ConnectionIndicator" Width="12" Height="12"
                             Fill="#FFB3261E" Margin="0,0,8,0" />
                    <TextBlock x:Name="ConnectionText" Text="드라이버 연결 안 됨"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="연결" Click="Connect_Click" />
                    <Button Content="연결 해제" Click="Disconnect_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl>
            <TabItem Header="파일 제어">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="250" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <GroupBox Header="감시 폴더" Padding="8">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                            HorizontalAlignment="Right" Margin="0,8,0,0">
                                    <Button Content="폴더 추가" Click="AddMonitorFolder_Click" />
                                    <Button Content="선택 제거" Click="RemoveMonitorFolder_Click" />
                                </StackPanel>
                                <ListBox x:Name="MonitorFolderList" ItemsSource="{Binding MonitorFolders}" />
                            </DockPanel>
                        </GroupBox>

                        <GroupBox Grid.Column="2" Header="보호 폴더" Padding="8">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Bottom" Margin="4,6,4,0"
                                           Foreground="#FF8A3B12" TextWrapping="Wrap"
                                           Text="현재 보호 정책은 사용자 모드 프로그램의 접근을 차단합니다." />
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                            HorizontalAlignment="Right" Margin="0,8,0,0">
                                    <Button Content="폴더 추가" Click="AddProtectFolder_Click" />
                                    <Button Content="선택 제거" Click="RemoveProtectFolder_Click" />
                                </StackPanel>
                                <ListBox x:Name="ProtectFolderList" ItemsSource="{Binding ProtectFolders}" />
                            </DockPanel>
                        </GroupBox>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,10,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                <Button Content="파일 드라이버 설치" Click="InstallFileDriver_Click" />
                                <Button Content="파일 드라이버 제거" Click="UninstallFileDriver_Click" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" x:Name="FileDriverStatusText"
                                       Text="설치 상태를 확인하지 않았습니다."
                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                       TextWrapping="Wrap" />
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PolicyStatusText" Text="정책이 적용되지 않았습니다."
                                       VerticalAlignment="Center" Margin="0,0,12,0"
                                       TextWrapping="Wrap" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="정책 적용" Click="ApplyPolicy_Click" />
                                <Button Content="정책 초기화" Click="ClearPolicy_Click" />
                                <Button Content="로그 지우기" Click="ClearLog_Click" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <GroupBox Grid.Row="2" Header="파일 이벤트 로그" Padding="8">
                        <DataGrid ItemsSource="{Binding EventLogs}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                                  EnableRowVirtualization="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="시각" Binding="{Binding Time}" Width="145" />
                                <DataGridTextColumn Header="구분" Binding="{Binding Action}" Width="70" />
                                <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="75" />
                                <DataGridTextColumn Header="프로세스" Binding="{Binding Image}" Width="240" />
                                <DataGridTextColumn Header="파일 경로" Binding="{Binding Path}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="프로세스 제어">
                <Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="프로세스 제어" FontSize="26" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="현재 단계에서는 구현하지 않습니다."
                                   FontSize="15" Foreground="#FF666666" Margin="0,12,0,0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                            <Button Content="프로세스 드라이버 설치" IsEnabled="False" />
                            <Button Content="프로세스 드라이버 제거" IsEnabled="False" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
