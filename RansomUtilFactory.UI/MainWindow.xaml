<Window x:Class="RansomUtilFactory.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RansomUtilFactory 개발 도구" Height="860" Width="1120"
        MinHeight="620" MinWidth="900"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top" Background="#FFF3F6FA" BorderBrush="#FFD7DEE8"
                BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="드라이버 연결 상태" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <WrapPanel Grid.Row="1">
                        <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                            <Ellipse x:Name="FileDriverConnectionIndicator" Width="12" Height="12"
                                     Fill="#FFB3261E" Margin="0,0,8,0" />
                            <TextBlock x:Name="FileDriverConnectionText" Text="파일 필터: 연결 안 됨"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                            <Ellipse x:Name="ProcessDriverConnectionIndicator" Width="12" Height="12"
                                     Fill="#FFB3261E" Margin="0,0,8,0" />
                            <TextBlock x:Name="ProcessDriverConnectionText" Text="프로세스 제어 필터: 연결 안 됨"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </WrapPanel>
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="ConnectFileButton" Content="파일 필터 연결" Click="Connect_Click" />
                        <Button x:Name="DisconnectFileButton" Content="파일 필터 연결 해제" Click="Disconnect_Click" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="프로세스 필터 로드·연결" Click="ConnectProcessDriver_Click" />
                        <Button Content="프로세스 필터 연결 해제" Click="DisconnectProcessDriver_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="MainTabs">
            <TabItem Header="파일 제어">
                <ScrollViewer x:Name="FileTabScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid x:Name="FileTabContent" Margin="10" MinHeight="720"
                      Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="340" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <GroupBox Header="감시 폴더" Padding="8">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                            HorizontalAlignment="Right" Margin="0,8,0,0">
                                    <Button Content="폴더 추가" Click="AddMonitorFolder_Click" />
                                    <Button Content="선택 제거" Click="RemoveMonitorFolder_Click" />
                                </StackPanel>
                                <ListBox x:Name="MonitorFolderList" ItemsSource="{Binding MonitorFolders}" />
                            </DockPanel>
                        </GroupBox>

                        <GroupBox Grid.Column="2" Header="보호 폴더" Padding="8">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Bottom">
                                    <TextBlock Margin="4,6,4,0"
                                               Foreground="#FF8A3B12" TextWrapping="Wrap"
                                               Text="허용 프로세스마다 읽기·쓰기, 코드 서명 확인 여부와 비교 방식을 설정합니다. 권한을 모두 끄면 정책을 적용할 수 없습니다." />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                Margin="0,8,0,0">
                                        <Button Content="폴더 추가" Click="AddProtectFolder_Click" />
                                        <Button Content="선택 제거" Click="RemoveProtectFolder_Click" />
                                    </StackPanel>
                                    <TextBlock Text="선택 폴더의 허용 프로그램" Margin="4,8,4,2" />
                                    <ListBox x:Name="AllowedProcessList" Height="86">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" ToolTip="{Binding Path}" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <CheckBox Content="읽기"
                                                                  IsChecked="{Binding AllowRead, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  Margin="8,0,0,0" VerticalAlignment="Center" />
                                                        <CheckBox Content="쓰기"
                                                                  IsChecked="{Binding AllowWrite, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  Margin="8,0,0,0" VerticalAlignment="Center" />
                                                        <CheckBox Content="코드 서명"
                                                                  IsChecked="{Binding RequireCodeSignature, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  Margin="8,0,0,0" VerticalAlignment="Center" />
                                                        <ComboBox SelectedIndex="{Binding MatchMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  ToolTip="프로세스 전체 경로 또는 실행 파일 이름으로 비교합니다."
                                                                  Width="108" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <ComboBoxItem Content="전체 경로" />
                                                            <ComboBoxItem Content="프로세스 이름" />
                                                        </ComboBox>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                Margin="0,6,0,0">
                                        <Button Content="프로그램 추가" Click="AddAllowedProcess_Click" />
                                        <Button Content="선택 제거" Click="RemoveAllowedProcess_Click" />
                                    </StackPanel>
                                </StackPanel>
                                <ListBox x:Name="ProtectFolderList" ItemsSource="{Binding ProtectFolders}"
                                         DisplayMemberPath="Path"
                                         SelectionChanged="ProtectFolderList_SelectionChanged" />
                            </DockPanel>
                        </GroupBox>
                    </Grid>

                    <GroupBox x:Name="BootProtectionPanel" Grid.Row="0" Header="MBR/GPT 선두 영역 보호" Padding="8" Margin="0,0,0,8">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="BootProtectionStatusText" Text="상태 미확인 · 파일 필터 연결 후 조회"
                                           FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="StartBootProtectionButton" Content="시작" Click="StartBootProtection_Click" IsEnabled="False" />
                                    <Button x:Name="StopBootProtectionButton" Content="정지" Click="StopBootProtection_Click" IsEnabled="False" />
                                    <Button x:Name="RefreshBootProtectionButton" Content="상태 새로 고침" Click="RefreshBootProtection_Click" IsEnabled="False" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="BootProtectionCountersText" Text="검사·차단·검사 실패 횟수: 미확인"
                                       TextWrapping="Wrap" Margin="0,3,0,0" />
                            <TextBlock x:Name="BootProtectionCommandText" Text="연결만으로 시작하지 않습니다. 연결 해제·폴더 정책 초기화는 보호를 정지하지 않습니다."
                                       TextWrapping="Wrap" Margin="0,3,0,0" />
                            <TextBlock Text="보호 범위: 선두 2 KiB 변경 비교. 전체 GPT 엔트리·백업 GPT 보호는 포함하지 않습니다."
                                       Foreground="#FF8A3B12" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                    </GroupBox>

                    <Grid Grid.Row="2" Margin="0,10,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                <Button x:Name="InstallFileButton" Content="파일 필터 설치" Click="InstallFileDriver_Click" />
                                <Button x:Name="UninstallFileButton" Content="파일 필터 제거" Click="UninstallFileDriver_Click" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" x:Name="FileDriverStatusText"
                                       Text="설치 상태를 확인하지 않았습니다."
                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                       TextWrapping="Wrap" />
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PolicyStatusText" Text="정책이 적용되지 않았습니다."
                                       VerticalAlignment="Center" Margin="0,0,12,0"
                                       TextWrapping="Wrap" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="ApplyPolicyButton" Content="정책 적용" Click="ApplyPolicy_Click" />
                                <Button x:Name="ClearPolicyButton" Content="정책 초기화" Click="ClearPolicy_Click" />
                                <Button Content="로그 지우기" Click="ClearLog_Click" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <GroupBox Grid.Row="3" Header="파일 이벤트 로그" Padding="8" MinHeight="125">
                        <DataGrid x:Name="FileEventGrid" ItemsSource="{Binding EventLogs}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                                  EnableRowVirtualization="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="시각" Binding="{Binding Time}" Width="145" MinWidth="145" />
                                <DataGridTextColumn Header="구분" Binding="{Binding Action}" Width="155" MinWidth="155" />
                                <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="75" MinWidth="75" />
                                <DataGridTextColumn Header="요청 프로세스 이미지 경로" Binding="{Binding Image}" Width="240" MinWidth="240" />
                                <DataGridTextColumn Header="파일 / 장치 경로" Binding="{Binding Path}" Width="*" MinWidth="160" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="프로세스 제어">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="220" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <GroupBox Header="프로세스 실행 허용 정책" Padding="8">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                        HorizontalAlignment="Right" Margin="0,8,0,0">
                                <Button Content="전체 경로 추가" Click="AddProcessPathRule_Click" />
                                <Button Content="파일 이름 추가" Click="AddProcessNameRule_Click" />
                                <Button Content="선택 제거" Click="RemoveProcessRule_Click" />
                                <Button x:Name="ApplyProcessPolicyButton" Content="정책 적용"
                                        Click="ApplyProcessPolicy_Click" />
                                <Button x:Name="ClearProcessPolicyButton" Content="정책 초기화"
                                        Click="ClearProcessPolicy_Click" />
                            </StackPanel>
                            <DataGrid x:Name="ProcessRuleGrid" ItemsSource="{Binding ProcessRules}"
                                      AutoGenerateColumns="False" IsReadOnly="False"
                                      CanUserAddRows="False" SelectionMode="Extended">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="규칙 ID" Binding="{Binding RuleId}" Width="80"
                                                        IsReadOnly="True" />
                                    <DataGridTextColumn Header="비교 방식" Binding="{Binding MatchModeText}" Width="110"
                                                        IsReadOnly="True" />
                                    <DataGridTextColumn Header="실행 파일" Binding="{Binding Image}" Width="*"
                                                        IsReadOnly="True" />
                                    <DataGridCheckBoxColumn Header="코드 서명 필요" Binding="{Binding IsSign, Mode=TwoWay}"
                                                            Width="110" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </GroupBox>

                    <Grid Grid.Row="1" Margin="0,10,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="프로세스 제어 필터 설치" Click="InstallProcessDriver_Click" />
                                <Button Content="프로세스 필터 로드·연결" Click="ConnectProcessDriver_Click" />
                                <Button Content="프로세스 필터 연결 해제" Click="DisconnectProcessDriver_Click" />
                                <Button Content="프로세스 제어 필터 제거" Click="UninstallProcessDriver_Click" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" x:Name="ProcessDriverStatusText"
                                       Text="설치 상태를 확인하지 않았습니다."
                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                       TextWrapping="Wrap" />
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ProcessPolicyStatusText"
                                       Text="프로세스 정책이 적용되지 않았습니다."
                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                            <Button Grid.Column="1" Content="로그 지우기"
                                    Click="ClearProcessLog_Click" />
                        </Grid>
                    </Grid>

                    <GroupBox Grid.Row="2" Header="정책에 등록된 프로세스 실행 로그 (차단 / 통과)" Padding="8">
                        <DataGrid ItemsSource="{Binding ProcessEventLogs}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False"
                                  EnableRowVirtualization="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="시각" Binding="{Binding Time}" Width="175" />
                                <DataGridTextColumn Header="프로세스명" Binding="{Binding ProcessName}" Width="160" />
                                <DataGridTextColumn Header="실행 결과" Binding="{Binding Action}" Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Action}" Value="차단">
                                                    <Setter Property="Foreground" Value="#B91C1C" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Action}" Value="통과">
                                                    <Setter Property="Foreground" Value="#15803D" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="70" />
                                <DataGridTextColumn Header="실행 파일 경로" Binding="{Binding Image}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
