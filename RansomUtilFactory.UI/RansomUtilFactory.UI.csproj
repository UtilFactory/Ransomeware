<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>RansomUtilFactory.UI</AssemblyName>
    <RootNamespace>RansomUtilFactory.UI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <CommonBinDir>$(SolutionDir)x64\$(Configuration)\bin\</CommonBinDir>
  </PropertyGroup>

  <ItemGroup Condition="'$(VCTargetsPath)' != ''">
    <ProjectReference Include="..\uf_fltwarp\uf_fltwarp.vcxproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\UF_FileFilterFactory\UF_FileFilterFactory.vcxproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\uf_procwarp\uf_procwarp.vcxproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\UF_ProcessFilterFactory\UF_ProcessFilterFactory.vcxproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="log4net" Version="3.3.2" />
    <None Update="log4net.config" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="Always" />
  </ItemGroup>

  <Target Name="CopyNativeLibrary" AfterTargets="Build">
    <Copy SourceFiles="$(SolutionDir)x64\$(Configuration)\uf_fltwarp.dll"
          DestinationFolder="$(OutDir)"
          Condition="Exists('$(SolutionDir)x64\$(Configuration)\uf_fltwarp.dll')" />
    <Copy SourceFiles="$(SolutionDir)x64\$(Configuration)\uf_procwarp.dll"
          DestinationFolder="$(OutDir)"
          Condition="Exists('$(SolutionDir)x64\$(Configuration)\uf_procwarp.dll')" />
  </Target>

  <Target Name="CopyProcessDriverPackage" AfterTargets="Build">
    <ItemGroup>
      <ProcessDriverPackage Include="$(SolutionDir)x64\$(Configuration)\UF_ProcessFilterFactory\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ProcessDriverPackage)"
          DestinationFolder="$(OutDir)Drivers\UF_ProcessFilterFactory\%(RecursiveDir)"
          SkipUnchangedFiles="true"
          Condition="'@(ProcessDriverPackage)' != ''" />
  </Target>

  <Target Name="CopyFileDriverPackage" AfterTargets="Build">
    <ItemGroup>
      <FileDriverPackage Include="$(SolutionDir)x64\$(Configuration)\UF_FileFilterFactory\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(FileDriverPackage)"
          DestinationFolder="$(OutDir)Drivers\UF_FileFilterFactory\%(RecursiveDir)"
          SkipUnchangedFiles="true"
          Condition="'@(FileDriverPackage)' != ''" />
  </Target>

  <Target Name="CopyWpfResultsToCommonBin" AfterTargets="Build">
    <ItemGroup>
      <WpfBuildResult Include="$(TargetDir)RansomUtilFactory.UI.exe" />
      <WpfBuildResult Include="$(TargetDir)RansomUtilFactory.UI.dll" />
      <WpfBuildResult Include="$(TargetDir)RansomUtilFactory.UI.deps.json" />
      <WpfBuildResult Include="$(TargetDir)RansomUtilFactory.UI.runtimeconfig.json" />
      <WpfBuildResult Include="$(TargetDir)log4net.dll" />
      <WpfBuildResult Include="$(TargetDir)log4net.config" />
    </ItemGroup>
    <MakeDir Directories="$(CommonBinDir)" />
    <Delete Files="$(CommonBinDir)RansomUtilFactory.UI.pdb" />
    <Copy SourceFiles="@(WpfBuildResult)" DestinationFolder="$(CommonBinDir)"
          SkipUnchangedFiles="true" Condition="'@(WpfBuildResult)' != ''" />
  </Target>
</Project>
