<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="Current" TreatAsLocalProperty="VisualStudioVersion" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64"><Configuration>Debug</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64"><Configuration>Release</Configuration><Platform>x64</Platform></ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{E8BB4E16-3DF6-4593-8A45-79F5E34033BB}</ProjectGuid>
    <Keyword>Win32Proj</Keyword><RootNamespace>UF_BootProtectionFactory</RootNamespace><ProjectName>UF_BootProtectionFactory</ProjectName>
    <WindowsTargetPlatformVersion>10.0.28000.0</WindowsTargetPlatformVersion>
    <VisualStudioVersion Condition="'$(VisualStudioVersion)'=='17.0'">18.0</VisualStudioVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Driver</ConfigurationType><DriverType>KMDF</DriverType><PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <TargetVersion>Windows10</TargetVersion><KmdfVersion>1.33</KmdfVersion>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup><TargetName>UF_BootProtectionFactory</TargetName><Inf2CatUseLocalTime>true</Inf2CatUseLocalTime><CommonBinDir>$(SolutionDir)x64\$(Configuration)\bin\</CommonBinDir></PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile><WarningLevel>Level4</WarningLevel><TreatWarningAsError>true</TreatWarningAsError><PreprocessorDefinitions>_AMD64_;AMD64;%(PreprocessorDefinitions)</PreprocessorDefinitions><AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions></ClCompile>
    <Link><AdditionalDependencies>Wdmsec.lib;%(AdditionalDependencies)</AdditionalDependencies><AdditionalOptions>/INTEGRITYCHECK %(AdditionalOptions)</AdditionalOptions></Link>
    <DriverSign><FileDigestAlgorithm>sha256</FileDigestAlgorithm></DriverSign>
    <PostBuildEvent><Command>if not exist "$(CommonBinDir)" mkdir "$(CommonBinDir)"
copy /Y "$(TargetPath)" "$(CommonBinDir)"</Command></PostBuildEvent>
  </ItemDefinitionGroup>
  <ItemGroup><ClCompile Include="src\driver.c" /><ClCompile Include="src\layout.c" /></ItemGroup>
  <ItemGroup><ClInclude Include="src\layout.h" /><ClInclude Include="include\uf_boot_protocol.h" /></ItemGroup>
  <ItemGroup><Inf Include="UF_BootProtectionFactory.inf" /></ItemGroup>
  <ItemGroup><FilesToPackage Include="$(TargetPath)" /></ItemGroup>
  <Target Name="CopyDriverPackageToCommonBin" AfterTargets="Build">
    <ItemGroup>
      <DriverPackageResult Include="$(SolutionDir)x64\$(Configuration)\UF_BootProtectionFactory\*.inf" />
      <DriverPackageResult Include="$(SolutionDir)x64\$(Configuration)\UF_BootProtectionFactory\*.cat" />
      <DriverPackageResult Include="$(SolutionDir)x64\$(Configuration)\$(TargetName).cer" Condition="'$(Configuration)'=='Debug' and Exists('$(SolutionDir)x64\$(Configuration)\$(TargetName).cer')" />
    </ItemGroup>
    <Delete Files="$(CommonBinDir)$(TargetName).cer" Condition="'$(Configuration)'!='Debug' and Exists('$(CommonBinDir)$(TargetName).cer')" />
    <Copy SourceFiles="@(DriverPackageResult)" DestinationFolder="$(CommonBinDir)" SkipUnchangedFiles="true" Condition="'@(DriverPackageResult)' != ''" />
  </Target>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
