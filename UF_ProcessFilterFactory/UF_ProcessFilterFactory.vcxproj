<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="Current" TreatAsLocalProperty="VisualStudioVersion" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{CC5B922A-62D4-4D7B-A664-98C9E9D2830D}</ProjectGuid>
    <Keyword>Win32Proj</Keyword>
    <RootNamespace>UF_ProcessFilterFactory</RootNamespace>
    <ProjectName>UF_ProcessFilterFactory</ProjectName>
    <WindowsTargetPlatformVersion>10.0.28000.0</WindowsTargetPlatformVersion>
    <VisualStudioVersion Condition="'$(VisualStudioVersion)'=='17.0'">18.0</VisualStudioVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="Configuration">
    <ConfigurationType>Driver</ConfigurationType>
    <DriverType>WDM</DriverType>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <TargetVersion>Windows10</TargetVersion>
    <UseDebugLibraries>true</UseDebugLibraries>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>Driver</ConfigurationType>
    <DriverType>WDM</DriverType>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <TargetVersion>Windows10</TargetVersion>
    <UseDebugLibraries>false</UseDebugLibraries>
    <WholeProgramOptimization>true</WholeProgramOptimization>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <TargetName>UF_ProcessFilterFactory</TargetName>
    <Inf2CatUseLocalTime>true</Inf2CatUseLocalTime>
    <CommonBinDir>$(SolutionDir)x64\$(Configuration)\bin\</CommonBinDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <PreprocessorDefinitions>_AMD64_;AMD64;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <AdditionalDependencies>Wdmsec.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalOptions>/INTEGRITYCHECK %(AdditionalOptions)</AdditionalOptions>
    </Link>
    <DriverSign>
      <FileDigestAlgorithm>sha256</FileDigestAlgorithm>
    </DriverSign>
    <PostBuildEvent>
      <Command>if not exist "$(CommonBinDir)" mkdir "$(CommonBinDir)"
copy /Y "$(TargetPath)" "$(CommonBinDir)"
if exist "$(CommonBinDir)$(TargetName).pdb" del /Q "$(CommonBinDir)$(TargetName).pdb"</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="src\control.c" />
    <ClCompile Include="src\driver.c" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="include\uf_processfilter_protocol.h" />
    <ClInclude Include="src\driver.h" />
  </ItemGroup>
  <ItemGroup>
    <Inf Include="UF_ProcessFilterFactory.inf" />
  </ItemGroup>
  <ItemGroup>
    <FilesToPackage Include="$(TargetPath)" />
  </ItemGroup>
  <Target Name="CopyDriverPackageToCommonBin" AfterTargets="Build">
    <ItemGroup>
      <DriverPackageResult Include="$(SolutionDir)x64\$(Configuration)\UF_ProcessFilterFactory\*.inf" />
      <DriverPackageResult Include="$(SolutionDir)x64\$(Configuration)\UF_ProcessFilterFactory\*.cat" />
      <DriverPackageResult Include="$(SolutionDir)x64\$(Configuration)\$(TargetName).cer"
                           Condition="'$(Configuration)'=='Debug' and Exists('$(SolutionDir)x64\$(Configuration)\$(TargetName).cer')" />
    </ItemGroup>
    <Delete Files="$(CommonBinDir)$(TargetName).cer"
            Condition="'$(Configuration)'!='Debug' and Exists('$(CommonBinDir)$(TargetName).cer')" />
    <Copy SourceFiles="@(DriverPackageResult)" DestinationFolder="$(CommonBinDir)"
          SkipUnchangedFiles="true" Condition="'@(DriverPackageResult)' != ''" />
  </Target>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
