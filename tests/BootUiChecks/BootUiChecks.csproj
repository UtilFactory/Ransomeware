<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CommonBinDir>$(MSBuildThisFileDirectory)..\..\x64\$(Configuration)\bin\</CommonBinDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../RansomUtilFactory.UI/BootNativeMethods.cs" Link="BootNativeMethods.cs" />
    <Compile Include="../../RansomUtilFactory.UI/BootDriverInstaller.cs" Link="BootDriverInstaller.cs" />
  </ItemGroup>
  <Target Name="CopyBootUiChecksToCommonBin" AfterTargets="Build">
    <ItemGroup>
      <BootUiCheckOutput Include="$(TargetDir)BootUiChecks.exe" />
      <BootUiCheckOutput Include="$(TargetDir)BootUiChecks.dll" />
      <BootUiCheckOutput Include="$(TargetDir)BootUiChecks.deps.json" />
      <BootUiCheckOutput Include="$(TargetDir)BootUiChecks.runtimeconfig.json" />
    </ItemGroup>
    <MakeDir Directories="$(CommonBinDir)" />
    <Copy SourceFiles="@(BootUiCheckOutput)" DestinationFolder="$(CommonBinDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
