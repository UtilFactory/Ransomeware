<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CommonBinDir>$(MSBuildThisFileDirectory)..\..\x64\$(Configuration)\bin\</CommonBinDir>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="../../RansomUtilFactory.UI/App.xaml" Link="BootUiRender.App.xaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyBootUiRenderToCommonBin" AfterTargets="Build">
    <ItemGroup>
      <BootUiRenderOutput Include="$(TargetDir)BootUiRender.exe" />
      <BootUiRenderOutput Include="$(TargetDir)BootUiRender.dll" />
      <BootUiRenderOutput Include="$(TargetDir)BootUiRender.deps.json" />
      <BootUiRenderOutput Include="$(TargetDir)BootUiRender.runtimeconfig.json" />
      <BootUiRenderOutput Include="$(TargetDir)BootUiRender.App.xaml" />
    </ItemGroup>
    <MakeDir Directories="$(CommonBinDir)" />
    <Copy SourceFiles="@(BootUiRenderOutput)" DestinationFolder="$(CommonBinDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
