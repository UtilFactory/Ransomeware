<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CommonBinDir>$(MSBuildThisFileDirectory)..\..\x64\$(Configuration)\bin\</CommonBinDir>
  </PropertyGroup>
  <Target Name="CopyChecksToCommonBin" AfterTargets="Build">
    <ItemGroup><CheckOutput Include="$(TargetDir)FileBootNativeChecks.exe;$(TargetDir)FileBootNativeChecks.dll;$(TargetDir)FileBootNativeChecks.deps.json;$(TargetDir)FileBootNativeChecks.runtimeconfig.json" /></ItemGroup>
    <MakeDir Directories="$(CommonBinDir)" />
    <Copy SourceFiles="@(CheckOutput)" DestinationFolder="$(CommonBinDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
